{
  "name": "fleetflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FleetFlow \u2014 fleet management web application (MVP)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n shared,api,web -c blue,green,magenta \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:shared": "tsc -b packages/shared --watch --preserveWatchOutput",
    "dev:api": "npm -w @fleetflow/api run dev",
    "dev:web": "npm -w @fleetflow/web run dev",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "build:shared": "tsc -b packages/shared",
    "build:api": "tsc -b apps/api",
    "build:web": "npm -w @fleetflow/web run build",
    "typecheck": "npm run typecheck:build && npm run typecheck:spec && npm -w @fleetflow/web run typecheck",
    "typecheck:build": "tsc -b packages/shared apps/api",
    "typecheck:spec": "tsc -p tsconfig.spec.json",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose -f docker/compose.dev.yml up -d",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "db:reset": "docker compose -f docker/compose.dev.yml down -v && npm run db:up",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "clean": "rimraf packages/*/dist apps/*/dist apps/*/tsconfig.tsbuildinfo packages/*/tsconfig.tsbuildinfo",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "start:api": "npm -w @fleetflow/api run start",
    "start:worker": "npm -w @fleetflow/api run start:worker",
    "pretest:e2e": "tsx scripts/reset-rate-limits.ts",
    "docs:api": "tsx scripts/generate-openapi.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "zod-to-json-schema": "^3.25.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  }
}
