# FleetFlow — environment template.
#
#   cp .env.example .env
#
# Variables fall into two tiers, and the API treats them differently:
#
#   REQUIRED   the process refuses to start without them, in every environment.
#   FEATURE    may be left empty during development. The feature they configure
#              is then reported as "unconfigured": the API still boots, logs a
#              warning at startup, and any request that actually needs the
#              feature fails with 503 SERVICE_UNCONFIGURED naming the missing
#              variables. In production they are REQUIRED — an unconfigured
#              mailer must never reach production silently.
#
# A partially filled feature block (some values set, some empty) is always a
# hard error, in every environment. Half-configured is a mistake, not a choice.

# =============================================================================
# REQUIRED
# =============================================================================

NODE_ENV=development
PORT=4000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Where the SPA is served from. Used to build links inside emails (password
# reset, notification deep links) and to seed the CORS allowlist.
APP_URL=http://localhost:5173

# Comma-separated. The Vite dev server origin.
CORS_ORIGINS=http://localhost:5173

# Matches docker/compose.dev.yml. In a real environment this is the Supabase
# Postgres connection string.
DATABASE_URL=postgresql://fleetflow:fleetflow@localhost:5432/fleetflow?schema=public

REDIS_URL=redis://localhost:6379

# Signs access tokens. Minimum 32 characters. The value below is a placeholder
# for local development ONLY — generate a real one per environment with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-replace-me-32ch

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# =============================================================================
# FEATURE — File storage (Supabase Storage)
# Needed by: document scans (DOC-02), maintenance invoices (MNT-03),
#            damage photos (DMG-04). Blocked on FF-004.
# =============================================================================

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# =============================================================================
# FEATURE — Transactional email (SMTP via Nodemailer)
# Needed by: password reset (AUTH-02) and every notification email (NTF).
# Blocked on FF-004 / FF-005.
#
# Leave empty in development: the mailer falls back to a preview transport that
# writes rendered messages to the log instead of sending them.
# =============================================================================

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender, e.g. "FleetFlow <notifications@example.com>"
SMTP_FROM=
# true for implicit TLS on port 465; false for STARTTLS on 587
SMTP_SECURE=
